# ─────────────────────────────────────────────────────────────
# Configuración del servidor. Copiá este archivo como `.env`
# (mismo nombre, sin `.example`) y completá lo que uses.
# El `.env` NO va al repo: tiene la contraseña del correo.
# ─────────────────────────────────────────────────────────────

# ── Correo saliente ──
# Cuenta desde la que salen los mensajes de recuperación.
MAIL_USER=gmcito234@gmail.com

# Contraseña de APLICACIÓN de Google (16 letras), no la del Gmail.
# Se saca en https://myaccount.google.com/apppasswords con la
# verificación en dos pasos activada. Si esto queda vacío, la app
# no manda nada por internet: escribe cada mensaje en `outbox/`.
MAIL_PASSWORD=

# Servidor SMTP. Gmail: smtp.gmail.com con 587 (STARTTLS) o 465 (SSL).
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_FROM_NAME=Cosmere Combat Tracker

# ── Enlaces de los correos ──
# Tiene que ser una dirección a la que lleguen desde donde abran el mail.
# En una LAN, la IP de la máquina que corre el server (no `localhost`).
BASE_URL=http://localhost:8000

# ── Panel de administración ──
# Cuentas con acceso a /admin, separadas por coma. Se compara con el
# email de la cuenta con la que se entra.
ADMIN_EMAILS=gmcito234@gmail.com

# ── Telemetría ──
# Días de historial que se guardan antes de purgarse solo.
TELEMETRY_DAYS=45
